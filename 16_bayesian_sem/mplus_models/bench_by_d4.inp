TITLE:
Bench Binary Probit Random Effects d=4 BAYES;
VARIABLE:
CLUSTER = id;
USEVARIABLES = y_bin x1-x3;
CATEGORICAL = y_bin;
WITHIN = x1-x3;
NAMES = y_bin x1 x2 x3 id;
MISSING = .;
ANALYSIS:
TYPE = TWOLEVEL RANDOM;
ESTIMATOR = BAYES;
LINK = PROBIT;
BITERATIONS = 5000 (2000);
PROCESSORS = 4;
BSEED = 2026;
MODEL:
%WITHIN%
s1 | y_bin ON x1;
s2 | y_bin ON x2;
s3 | y_bin ON x3;
%BETWEEN%
y_bin s1-s3;
y_bin s1-s3 WITH y_bin s1-s3;
DATA:
FILE = "bench_by_d4.dat";
